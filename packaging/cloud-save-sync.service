# systemd user service for Cloud Save Sync (Linux).
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp packaging/cloud-save-sync.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now cloud-save-sync.service
# The packaged binary is expected at ~/bin/CloudSaveSync/CloudSaveSync;
# otherwise adapt ExecStart to point at savesync.py + python3.

[Unit]
Description=Cloud Save Sync (game saves <-> cloud sync)
After=network-online.target

[Service]
Type=simple
ExecStart=%h/bin/CloudSaveSync/CloudSaveSync --cli watch
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
