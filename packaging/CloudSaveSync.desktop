[Desktop Entry]
Type=Application
Name=Cloud Save Sync
Comment=Bidirectional sync of game saves to the cloud
Exec=/usr/bin/env python3 /opt/CloudSaveSync/savesync.py gui
# Adapt Exec= to the real path of the packaged app (or launch the AppImage):
# Exec=%h/bin/CloudSaveSync/CloudSaveSync
Icon=cloud-save-sync
Terminal=false
Categories=Utility;Game;
StartupWMClass=cloud-save-sync
